# sbt / Scala build output
target/
project/target/
project/project/
*.class

# npm / Vite build output (console-tyrian) -- node_modules is
# regenerated entirely from package.json + package-lock.json via
# `npm install`, never meant to be committed; dist/ is npm run build's
# output, same story.
node_modules/
dist/

# The built console, copied manually into place during stage 1 of
# packaging it into the release image -- now regenerated automatically
# by the Docker build (console-tyrian-build stage -> COPY into build's
# resources before sbt assembly, see Dockerfile), so committing these
# would just be stale build output, the same category as the two
# entries above.
src/main/resources/_llmsim/console/

# Metals / Bloop (Scala IDE tooling)
.bloop/
.bsp/
.metals/
.ammonite/
metals.sbt

# IDE
.idea/
.vscode/
*.iml

# OS cruft
.DS_Store
Thumbs.db

# Logs
*.log

# Local env overrides (if you ever add one)
.env
